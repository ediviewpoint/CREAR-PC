{
  "name": "crear-pc",
  "version": "0.1.0",
  "private": true,
  "description": "Configurador boliviano de PCs a medida — catálogo, validador de compatibilidad y proforma PDF. Santa Cruz, Bolivia.",
  "author": "Elías Balcázar Martínez",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:adopt": "node scripts/prisma-adopt.mjs",
    "test:admin:base": "tsx scripts/review-admin-base.ts",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:ui": "vitest --ui --configLoader runner",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:import-prices": "tsx scripts/import-prices.ts",
    "prices:check": "tsx scripts/import-prices.ts --check",
    "smoke": "tsx scripts/smoke-check.ts",
    "prices:refresh": "tsx scripts/refresh-prices.ts",
    "db:check": "node scripts/db-status.mjs",
    "db:migrations:check": "node scripts/migration-check.mjs",
    "test:migration-history": "node --test scripts/lib/migration-history.test.mjs",
    "test:review-database": "node --test scripts/lib/pglite-review-wire.test.mjs",
    "production:check": "node scripts/production-check.mjs",
    "test:production-config": "node --test scripts/lib/production-config.test.mjs",
    "seed:check": "tsx scripts/seed.ts --check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^6.0.2",
    "@prisma/adapter-pg": "7",
    "@prisma/client": "7",
    "@react-pdf/renderer": "^4.1.5",
    "@sentry/nextjs": "^11.10.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/blob": "^2.8.2",
    "@vercel/og": "^1.0.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "fractional-indexing": "^4.0.0",
    "lucide-react": "^1.64.0",
    "motion": "^14.7.1",
    "nanoid": "^5.0.9",
    "next": "^16.0.0",
    "next-auth": "5.0.0-beta.32",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "pino": "^9.5.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.35.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.5.5",
    "xlsx": "^0.18.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@napi-rs/canvas": "^1.0.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@vercel/config": "^0.14.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "pdfjs-dist": "^6.4.299",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "7.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
