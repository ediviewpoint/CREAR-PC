# ============================================================
# CREAR PC — Variables de entorno (plantilla)
# ============================================================
# Copiar a .env.local:
#   Copy-Item .env.example .env.local
# Luego llenar con credenciales reales.
# Nunca commitear .env.local.
# ============================================================

# ---------- Base de datos (Supabase Postgres) ----------
# Obtener con: vercel env pull .env.local
# El password lo encontrás en Supabase → Settings → Database → Connection string → URI (pooler).
DATABASE_URL=postgresql://postgres.ajxidbnxeutyhwzanytk:__PASSWORD__@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Supabase REST — para operaciones públicas con RLS
NEXT_PUBLIC_SUPABASE_URL=https://ajxidbnxeutyhwzanytk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Blob (imágenes de componentes + PDFs de proformas) ----------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# ---------- Autenticación (Clerk — Fase 2) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/build
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/build

# ---------- Vercel AI Gateway (opcional — recomendador IA Fase 2) ----------
AI_GATEWAY_API_KEY=

# Claude: solo servidor. Nunca usar NEXT_PUBLIC_ para la clave.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---------- Site config ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=CREAR PC
NEXT_PUBLIC_SITE_LOCALE=es-BO
NEXT_PUBLIC_DEFAULT_CURRENCY=BOB
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@crearpc.bo
NEXT_PUBLIC_SUPPORT_WHATSAPP=+591-00000000

# ---------- Seguridad ----------
# Protege endpoints /api/cron/*
CRON_SECRET=generar-un-string-aleatorio-largo

# ---------- Tasa de cambio (opcional, BCB oficial) ----------
BCB_RATE_SOURCE=manual        # manual | api
BCB_USD_BOB=6.96              # tasa oficial de referencia (BCB)

# ---------- Observabilidad (opcional — Sentry) ----------
# Si están vacíos, Sentry no se inicializa (sin overhead).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Solo para build-time (source maps upload). Opcional.
SENTRY_AUTH_TOKEN=

# ---------- Email transaccional (opcional — Resend) ----------
# Si está vacío, el flujo de envío de proformas por email queda inactivo.
# El cliente igual puede descargar el PDF.
RESEND_API_KEY=
# Remitente verificado en Resend (dominio propio recomendado para producción).
RESEND_FROM_EMAIL=
# Nombre que aparece como remitente (ej. "ELITEPC Proformas").
RESEND_FROM_NAME=

# ---------- Entorno ----------
NODE_ENV=development

# Contraseña del admin: al menos 16 caracteres; nunca NEXT_PUBLIC_
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_NAME=Administrador ElitePC
AUTH_SECRET=
# Google es opcional y solo admite usuarios previamente creados por ADMIN.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GOOGLE_DOMAIN=
TIPO_CAMBIO_URL=
WP_URL=
WP_USER=
WP_APP_PASSWORD=
AI_API_KEY=
AI_MODEL_EXTRACCION=claude-haiku-5-5
AI_MODEL_REDACCION=claude-haiku-5-5
AI_WEB_SEARCH_ENABLED=false
# Feed JSON HTTPS opcional; si falta se usa entrada manual
PRICE_FEED_URL=

# ---------- Datos legales del responsable (ELITEPC) ----------
# Vacíos por defecto. Si se completan, aparecen en PDF, footer y /contacto.
# Sin estos valores, la UI oculta esas secciones (nunca inventa correos ni NIT).
LEGAL_RESPONSIBLE=
LEGAL_NIT=
LEGAL_ADDRESS=
LEGAL_CITY=
NEXT_PUBLIC_CONTACT_EMAIL=
